# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=todoapp

# --- Auth / Session ---
# Use a long random string in production.
JWT_SECRET=your_super_secret_key_here
COOKIE_NAME=session_id
COOKIE_SAME_SITE=lax
# Set to "true" when serving over HTTPS in production.
COOKIE_SECURE=false
COOKIE_MAX_AGE_SECONDS=604800

# --- Server ---
PORT=3000
NODE_ENV=development
# Origin of the frontend that is allowed to call this API (CORS).
FRONTEND_URL=http://localhost:5173
